    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de hoy (AAAA-MM-DD) en la hora local de la PC",
          "const d = new Date(); const p = n => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('hoy', `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`);"
        ]
      }
    }
