# Plantilla de variables de entorno.
# Copia este archivo como ".env" (en esta misma carpeta) y pon tus propios valores.
# El archivo .env NUNCA se sube a Git.

# --- Base de datos (Docker Compose y Spring Boot usan las mismas) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ferreteria
DB_USER=ferreteria
DB_PASSWORD=cambia_esta_clave

# --- Seguridad ---
# Clave para firmar los tokens JWT: minimo 32 caracteres, inventala y no la compartas
JWT_SECRET=cambia_esta_clave_por_una_larga_de_al_menos_32_caracteres
# Usuario ADMIN que se crea al arrancar si no existe ninguno
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# --- Fotos de productos (opcional) ---
# Si se deja vacio, las fotos se guardan en la carpeta local ./imagenes
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Datos de demostracion (solo perfil dev) ---
# Contrasena de los usuarios vendedor1, vendedor2 y almacen1
DEMO_PASSWORD=Demo123!

# --- Cotizaciones: enlaces y correo (opcional) ---
# URL publica del backend para el enlace de descarga del PDF por WhatsApp (en la nube, Ej: https://api.miferreteria.pe)
APP_URL_PUBLICA=
# Servidor SMTP para enviar cotizaciones por correo (Ej: smtp.gmail.com, 587 y una contrasena de aplicacion)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Asistente de IA (opcional) ---
# Clave de Claude: se crea en https://platform.claude.com/settings/keys (ver docs/GUIA_CLAVE_IA.md).
# Vacia = el asistente avisa que no esta configurado y el resto funciona igual.
ANTHROPIC_API_KEY=
# Modelo (el mas economico por defecto) y preguntas por usuario al dia
IA_MODELO=claude-haiku-5-5
IA_PREGUNTAS_POR_DIA=50

# Respaldo automatico diario (servicio "respaldo" de docker-compose.yml): dias que se guardan
RESPALDO_DIAS=30
